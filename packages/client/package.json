{
  "name": "@agent-tunnel/client",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript filesystem client for the agent-tunnel.9p.v1 profile: descriptor, authenticated WSS, 9P2000.L codec, session, bytes and limits — plus the four native framework adapters, each reached through its own export subpath and each depending on its framework by type only.",
  "license": "SEE LICENSE IN ../../LICENSE",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ninep": "./src/ninep/codec.ts",
    "./files-sdk": "./src/adapters/files-sdk.ts",
    "./mastra": "./src/adapters/mastra.ts",
    "./just-bash": "./src/adapters/just-bash.ts",
    "./ai-sdk": "./src/adapters/ai-sdk.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "node scripts/lint.ts",
    "lint:dist": "node scripts/lint.ts --dist",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "test:peers": "node --test --test-reporter=spec \"test/peers/*.peers.ts\"",
    "test:consumer-overrides": "node scripts/consumer-overrides.ts",
    "check": "npm run lint && npm run typecheck && npm run build && npm run lint:dist && npm test && npm run test:peers",
    "demo:adapters": "../../scripts/adapters-demo.sh",
    "fuzz:generate": "node fuzz/generate.ts"
  },
  "dependencies": {},
  "peerDependencies": {
    "@ai-sdk/provider": "4.0.11",
    "@mastra/core": "1.65.0",
    "ai": "7.0.94",
    "files-sdk": "2.4.0",
    "just-bash": "3.4.2"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/provider": { "optional": true },
    "@mastra/core": { "optional": true },
    "ai": { "optional": true },
    "files-sdk": { "optional": true },
    "just-bash": { "optional": true }
  },
  "overrides": {
    "@mastra/core": {
      "@modelcontextprotocol/server": "2.3.0"
    },
    "just-bash": {
      "minimatch": "11.0.1"
    }
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.11",
    "@mastra/core": "1.65.0",
    "@types/node": "24.10.1",
    "ai": "7.0.94",
    "files-sdk": "2.4.0",
    "just-bash": "3.4.2",
    "typescript": "5.9.3",
    "zod": "4.6.6"
  }
}
